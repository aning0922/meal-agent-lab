{
  "name": "@meal-agent/contracts",
  "version": "0.4.0",
  "private": true,
  "description": "Runtime-validatable shared contracts for Meal Agent clients and services",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/api.js",
    "./dist/contract-rule-schema.js",
    "./dist/identity.js",
    "./dist/inventory.js",
    "./dist/inventory-v2.js",
    "./dist/meals.js",
    "./dist/members.js",
    "./dist/primitives.js",
    "./dist/refinement-bindings.js",
    "./dist/shopping.js"
    ,"./dist/seasoning-v1.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./inventory-v2": {
      "types": "./dist/inventory-v2.d.ts",
      "import": "./dist/inventory-v2.js"
    },
    "./members": {
      "types": "./dist/members.d.ts",
      "import": "./dist/members.js"
    },
    "./meals": {
      "types": "./dist/meals.d.ts",
      "import": "./dist/meals.js"
    },
    "./shopping": {
      "types": "./dist/shopping.d.ts",
      "import": "./dist/shopping.js"
    }
    ,"./seasoning-v1": {
      "types": "./dist/seasoning-v1.d.ts",
      "import": "./dist/seasoning-v1.js"
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
