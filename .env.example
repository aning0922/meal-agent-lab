# 服务端实际读取的完整变量清单见 services/api/.env.example
NODE_ENV=development
# 没有默认值，必须显式声明；fake 微信 adapter 只允许 local-test + loopback。
DEPLOYMENT_STAGE=local-test
DEPLOYMENT_EXPOSURE=loopback
PORT=
API_BASE_URL=
# 与 DATABASE_URL_FILE 互斥，恰好设置其中一个；容器与 Compose 走 _FILE。
DATABASE_URL=
# DATABASE_URL_FILE=
DATABASE_APP_ROLE=meal_agent_app
WECHAT_ADAPTER=fake
WECHAT_APP_ID=
WECHAT_APP_SECRET=
LOG_LEVEL=
