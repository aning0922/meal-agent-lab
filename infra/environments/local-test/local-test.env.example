# 阶段 09A / M3B：local-test 环境模板。
#
# 复制为同目录的 local-test.env（未跟踪）后按需修改：
#
#   cp infra/environments/local-test/local-test.env.example \
#      infra/environments/local-test/local-test.env
#   docker compose --env-file infra/environments/local-test/local-test.env \
#      --file infra/docker/compose.local-test.yaml config
#
# 本模板只含非敏感配置与空占位。口令与连接串一律走未跟踪的 secret file
# （infra/docker/secrets/README.md）；本文件不得出现任何口令、token、真实
# AppID/AppSecret 或完整连接串。local-test 不是 staging，也不是 production。

# Compose project name。并行 worktree 同时起栈时必须互不相同，否则会抢占同
# 一张网络与同一个数据卷（也可用 --project-name 覆盖）。
COMPOSE_PROJECT_NAME=meal-agent-local-test

# API 的宿主端口。host 侧固定发布到 127.0.0.1，地址不可配置。
MEAL_AGENT_API_HOST_PORT=3000

# Secret 目录。留空 = 默认 infra/docker/secrets/；也可指向仓库之外一个
# 0700 的目录（由 generate-local-test-secrets.mjs --directory 生成）。
MEAL_AGENT_SECRETS_DIR=

# ---------------------------------------------------------------------------
# 部署身份（固定值）。compose.local-test.yaml 已把它们钉在 api 服务上，写在
# 这里是为了让「这套环境是什么」有一份可读的声明；改动它们不会改变 Compose
# 的行为，改 Compose 里的对应值则会被静态门禁与 API 启动前校验拒绝。
# ---------------------------------------------------------------------------
DEPLOYMENT_STAGE=local-test
DEPLOYMENT_EXPOSURE=loopback
WECHAT_ADAPTER=fake

# 真实微信凭据在 local-test 必须保持为空：API 在 local-test 发现非空
# AppID/AppSecret 会在启动前 fail closed（M3A），tracked 模板携带非空值会被
# secret 预检拒绝（M3B）。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
