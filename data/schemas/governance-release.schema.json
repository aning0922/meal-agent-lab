{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic://meal-agent/stage09p-m0/governance-release.schema.json",
  "$comment": "runtime-owned: decode.ts scalar closure; standard JSON Schema/Ajv does not claim negative-zero distinction",
  "title": "Stage 09P M0 governance release",
  "$ref": "#/$defs/governanceRelease",
  "$defs": {
    "scalarString": {
      "type": "string",
      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    },
    "nonEmptyString": {
      "allOf": [
        { "$ref": "#/$defs/scalarString" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "positiveRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "allOf": [
        { "$ref": "#/$defs/scalarString" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "timestamp": {
      "allOf": [
        { "$ref": "#/$defs/scalarString" },
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
      ]
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "$ref": "#/$defs/scalarString" },
        {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": { "$ref": "#/$defs/scalarString" },
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "role"],
      "properties": {
        "actorId": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "governedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "entityId", "entityRevision"],
      "properties": {
        "datasetId": { "$ref": "#/$defs/nonEmptyString" },
        "entityId": { "$ref": "#/$defs/nonEmptyString" },
        "entityRevision": { "$ref": "#/$defs/positiveRevision" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceId", "referenceRevision", "locator"],
      "properties": {
        "referenceId": { "$ref": "#/$defs/nonEmptyString" },
        "referenceRevision": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "referenceId",
        "referenceRevision",
        "locator",
        "contentDigest",
        "retrievedAt"
      ],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "referenceId": { "$ref": "#/$defs/nonEmptyString" },
        "referenceRevision": { "$ref": "#/$defs/nonEmptyString" },
        "locator": { "$ref": "#/$defs/nonEmptyString" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "retrievedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "region",
        "language",
        "sourceReferenceId",
        "sourceReferenceRevision"
      ],
      "properties": {
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "region": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "sourceReferenceId": { "$ref": "#/$defs/nonEmptyString" },
        "sourceReferenceRevision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "syntheticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "generator",
        "containsRealUserData",
        "containsRealFoodFacts",
        "purpose"
      ],
      "properties": {
        "classification": { "const": "fully_synthetic" },
        "generator": { "const": "stage09p-m0-fixture-v1" },
        "containsRealUserData": { "const": false },
        "containsRealFoodFacts": { "const": false },
        "purpose": { "const": "governance-format-and-fail-closed-testing-only" }
      }
    },
    "officialEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "containsRealFoodFacts",
        "containsRealUserData",
        "fullTextCopied",
        "purpose",
        "factDisposition",
        "usageStatus"
      ],
      "properties": {
        "classification": { "const": "official_source_projection" },
        "containsRealFoodFacts": { "const": true },
        "containsRealUserData": { "const": false },
        "fullTextCopied": { "const": false },
        "purpose": { "const": "household-safety-provenance-only" },
        "factDisposition": {
          "enum": ["POSITIVE_BLOCK", "UNKNOWN_BLOCK", "CANDIDATE_CLEAR", "REVIEWED_CLEAR"]
        },
        "usageStatus": { "enum": ["pending", "approved"] }
      }
    },
    "governanceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["syntheticEvidence"],
          "properties": {
            "approvers": { "type": "array", "minItems": 1 },
            "syntheticEvidence": { "$ref": "#/$defs/syntheticEvidence" }
          }
        },
        {
          "required": ["officialEvidence"],
          "properties": {
            "officialEvidence": { "$ref": "#/$defs/officialEvidence" }
          }
        }
      ],
      "required": [
        "schemaVersion",
        "datasetId",
        "datasetKind",
        "entityId",
        "entityRevision",
        "lifecycleStatus",
        "owner",
        "approvers",
        "sourceTier",
        "sourceReferences",
        "sourceSnapshots",
        "applicableRegions",
        "languages",
        "licenseStatus",
        "licenseReference",
        "retrievedAt",
        "reviewedAt",
        "reviewDueAt",
        "aliases",
        "supersededBy",
        "withdrawalState",
        "withdrawalReason",
        "withdrawnAt",
        "content"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "datasetId": { "$ref": "#/$defs/nonEmptyString" },
        "datasetKind": {
          "enum": [
            "food_concept",
            "allergen",
            "religious_ethical",
            "food_safety",
            "cooking_technique"
          ]
        },
        "entityId": { "$ref": "#/$defs/nonEmptyString" },
        "entityRevision": { "$ref": "#/$defs/positiveRevision" },
        "lifecycleStatus": {
          "enum": ["draft", "under_review", "approved", "active", "superseded", "withdrawn"]
        },
        "owner": { "$ref": "#/$defs/actor" },
        "approvers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/actor" }
        },
        "sourceTier": { "enum": ["L1", "L2", "L3", "L4"] },
        "sourceReferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "sourceSnapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceSnapshot" }
        },
        "applicableRegions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "licenseStatus": { "enum": ["approved", "restricted", "pending", "rejected"] },
        "licenseReference": {
          "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
        },
        "retrievedAt": { "$ref": "#/$defs/timestamp" },
        "reviewedAt": { "$ref": "#/$defs/timestamp" },
        "reviewDueAt": { "$ref": "#/$defs/timestamp" },
        "aliases": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/alias" }
        },
        "supersededBy": {
          "oneOf": [{ "$ref": "#/$defs/governedReference" }, { "type": "null" }]
        },
        "withdrawalState": { "enum": ["not_withdrawn", "withdrawn"] },
        "withdrawalReason": {
          "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
        },
        "withdrawnAt": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        },
        "content": { "$ref": "#/$defs/jsonValue" },
        "syntheticEvidence": { "$ref": "#/$defs/syntheticEvidence" },
        "officialEvidence": { "$ref": "#/$defs/officialEvidence" }
      }
    },
    "governanceRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "releaseId",
        "releaseRevision",
        "contentDigest",
        "envelopes"
      ],
      "properties": {
        "$schema": { "$ref": "#/$defs/nonEmptyString" },
        "schemaVersion": { "const": 1 },
        "releaseId": { "$ref": "#/$defs/nonEmptyString" },
        "releaseRevision": { "$ref": "#/$defs/positiveRevision" },
        "contentDigest": { "$ref": "#/$defs/digest" },
        "envelopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/governanceEnvelope" }
        }
      }
    }
  }
}
