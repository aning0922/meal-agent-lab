{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic://meal-agent/stage09p-m0/invalid-governance-fixture.schema.json",
  "title": "Stage 09P M0 fully synthetic invalid fixture mutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "syntheticFixture",
    "baseValidFiles",
    "mutations",
    "hardMappings",
    "recomputeReleaseDigests",
    "expectedIssueCodes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "syntheticFixture": { "const": "fully_synthetic_mutation" },
    "baseValidFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/validFile" }
    },
    "mutations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/setMutation" },
          { "$ref": "#/$defs/duplicateEnvelopeMutation" }
        ]
      }
    },
    "hardMappings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hardMapping" }
    },
    "recomputeReleaseDigests": { "type": "boolean" },
    "expectedIssueCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MISSING_SOURCE",
          "MISSING_LICENSE",
          "MISSING_REGION",
          "MISSING_LANGUAGE",
          "ALIAS_CONFLICT",
          "REUSED_ENTITY_ID",
          "UNKNOWN_REVISION",
          "WITHDRAWN_REFERENCE",
          "RELEASE_DIGEST_MISMATCH",
          "HARD_MAPPING_UNRESOLVED"
        ]
      }
    }
  },
  "$defs": {
    "validFile": {
      "enum": [
        "food-concept.json",
        "allergen.json",
        "religious-ethical.json",
        "food-safety.json",
        "cooking-technique.json"
      ]
    },
    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "setMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "releaseIndex", "envelopeIndex", "field", "value"],
      "properties": {
        "operation": { "const": "set" },
        "releaseIndex": { "$ref": "#/$defs/index" },
        "envelopeIndex": { "$ref": "#/$defs/index" },
        "field": {
          "enum": [
            "sourceReferences",
            "sourceSnapshots",
            "aliases",
            "applicableRegions",
            "languages",
            "licenseStatus",
            "licenseReference",
            "entityId",
            "lifecycleStatus",
            "withdrawalState",
            "withdrawalReason",
            "withdrawnAt",
            "contentDigest"
          ]
        },
        "value": {}
      }
    },
    "duplicateEnvelopeMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "releaseIndex",
        "envelopeIndex",
        "entityId",
        "syntheticToken",
        "aliasValue"
      ],
      "properties": {
        "operation": { "const": "duplicate_envelope" },
        "releaseIndex": { "$ref": "#/$defs/index" },
        "envelopeIndex": { "$ref": "#/$defs/index" },
        "entityId": {
          "type": "string",
          "pattern": "^01900000-7000-7000-8000-0000000000[0-9]{2}$"
        },
        "syntheticToken": { "type": "string", "pattern": "^SYNTHETIC_[A-Z0-9_]+$" },
        "aliasValue": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "entityId", "entityRevision"],
      "properties": {
        "datasetId": { "type": "string", "pattern": "^syn:dataset:" },
        "entityId": {
          "type": "string",
          "pattern": "^01900000-7000-7000-8000-0000000000[0-9]{2}$"
        },
        "entityRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "hardMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "source", "target", "required"],
      "properties": {
        "mappingId": { "type": "string", "pattern": "^syn:mapping:" },
        "source": { "$ref": "#/$defs/reference" },
        "target": { "$ref": "#/$defs/reference" },
        "required": { "const": true }
      }
    }
  }
}
