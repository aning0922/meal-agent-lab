{
  "name": "@meal-agent/client-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Disposable Taro spike for Meal Agent cross-platform validation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build:weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "mock:api": "node scripts/mock-api.mjs",
    "preview:weapp": "node scripts/open-weapp.mjs",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.17",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "18.3.31",
    "@types/webpack-env": "1.18.8",
    "babel-preset-taro": "4.2.1",
    "less": "4.6.7",
    "postcss": "8.5.22",
    "react-refresh": "0.14.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "webpack": "5.91.0"
  }
}
