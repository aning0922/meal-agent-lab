{
  "name": "@meal-agent/api",
  "version": "0.1.0",
  "private": true,
  "description": "Stage 08 audited modular-monolith API vertical slice",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run manifest:check && pnpm run test:unit && pnpm run test:http && pnpm run test:db && pnpm run openapi:check && pnpm run build",
    "db:bootstrap": "tsx src/database/bootstrap-0000.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:test": "tsx scripts/with-test-database.ts migration",
    "dev": "tsx watch src/index.ts",
    "environment:check": "tsx scripts/check-stage-environment.ts",
    "manifest:check": "tsx scripts/check-stage06-manifest.ts",
    "manifest:generate": "tsx scripts/generate-stage06-manifest.ts",
    "openapi:check": "tsx scripts/check-openapi.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "start": "node dist/index.js",
    "test": "pnpm run test:unit && pnpm run test:http && pnpm run test:db",
    "test:db": "tsx scripts/with-test-database.ts test",
    "test:http": "node --import tsx --test tests/http/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@meal-agent/contracts": "workspace:*",
    "@meal-agent/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "ajv": "8.20.0",
    "drizzle-kit": "0.31.10",
    "openapi-types": "12.1.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
