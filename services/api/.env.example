NODE_ENV=development
# 部署身份与暴露级别没有默认值，必须显式声明；它们与 NODE_ENV 互相不覆盖。
# DEPLOYMENT_STAGE：local-test | staging | production
# DEPLOYMENT_EXPOSURE：loopback | private-network | public
# fake 微信 adapter 只允许 local-test + loopback + 非 production。
DEPLOYMENT_STAGE=local-test
DEPLOYMENT_EXPOSURE=loopback
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# DATABASE_URL 与 DATABASE_URL_FILE 互斥：必须恰好设置其中一个；两者同时出现
# （即使取值相同）或都不出现都会在启动前失败。容器与 Compose 走 _FILE，
# 该文件必须是绝对路径、普通文件、属主为运行进程、权限 0600、单行。
DATABASE_URL=
# DATABASE_URL_FILE=
DATABASE_APP_ROLE=meal_agent_app
WECHAT_ADAPTER=fake
# local-test 不得携带真实凭据：这两项非空会让服务在启动前失败。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 只接受这一个官方地址，逐字节相同；端口、query、fragment 与尾斜杠都会被拒绝。
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_IDLE_TTL_DAYS=7
